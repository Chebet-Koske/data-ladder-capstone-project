# ===== Data: ignore everything inside data/ except the instructions =====
data/*
!data/README.md
!data/processed/
data/processed/*
!data/processed/.gitkeep

# Raw and processed data files (also catches stray copies elsewhere)
*.csv
*.csv.gz
*.tsv

# Database files
*.db
*.sqlite
*.sqlite3

# Compressed outputs
*.gz
*.zip
*.tar
*.7z
*.bz2

# Model / scaler artifacts (regenerated by the notebooks)
*.joblib
*.pkl
*.pickle

# ===== Jupyter =====
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ===== Python =====
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# ===== Virtual environments =====
.venv/
venv/
env/

# ===== OS / editor =====
.DS_Store
Thumbs.db
.idea/
.vscode/
